Sub PrintOneExcelToMultiPDF()
    Dim FilePath As String
    Dim ws As Worksheet
    Dim SavePath As String
    Dim PDFName As String
    Dim OriginalWorkbookName As String
    Dim FileParts() As String

    ' Prompt the user to select the Excel file
    FilePath = Application.GetOpenFilename("Excel Files (*.xlsx), *.xlsx")
    
    If FilePath = "False" Then
        MsgBox "No file selected. Exiting the macro."
        Exit Sub
    End If

    ' Open the selected Excel file
    Workbooks.Open (FilePath)
    
    ' Split the selected path to get the file name and extension
    FileParts = Split(FilePath, Application.PathSeparator)
    OriginalWorkbookName = FileParts(UBound(FileParts))
    OriginalWorkbookName = Left(OriginalWorkbookName, InStrRev(OriginalWorkbookName, ".") - 1)

    ' Activate the original Excel file
    Workbooks(OriginalWorkbookName).Activate
    
    
    
    ' Create the path for the folder where you want to save the PDF files
    SavePath = "C:\DDD\temp\" ' Modify this to your desired folder path
    
    ' Check if the folder exists, and if not, create it
    If Dir(SavePath, vbDirectory) = "" Then
        MkDir SavePath
    End If
    
    ' Loop through each sheet in the workbook
    'For Each ws In ThisWorkbook.Sheets
     For Each ws In ActiveWorkbook.Sheets
        ' Create the full PDF file name using the specified path and sheet name
        PDFName = SavePath & OriginalWorkbookName & "_" & ws.Name & ".pdf"
        
        ' Print the current sheet to "Microsoft Print to PDF"
        ws.ExportAsFixedFormat Type:=xlTypePDF, Filename:=PDFName, Quality:=xlQualityStandard, _
            IncludeDocProperties:=True, IgnorePrintAreas:=False, OpenAfterPublish:=False
    Next ws
    
    ' Activate the original Excel file
    Workbooks(OriginalWorkbookName).Activate
    
    ' Close the original Excel file without saving changes
    ActiveWorkbook.Close SaveChanges:=False
    ThisWorkbook.Activate
End Sub
