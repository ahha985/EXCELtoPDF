Sub PrintMultiExcelToMultiPDF()
    Dim FileDialog As FileDialog
    Dim SelectedItems As FileDialogSelectedItems
    Dim FilePath As String
    Dim SavePath As String
    Dim PDFName As String
    Dim OriginalWorkbookName As String
    Dim sheetName As String
    Dim FileParts() As String
    Dim i As Integer, j As Integer
    Dim wb As Workbook

    ' Prompt the user to select multiple Excel files
    Set FileDialog = Application.FileDialog(msoFileDialogOpen)
    With FileDialog
        .AllowMultiSelect = True
        .Title = "Select Excel Files"
        .Filters.Add "Excel Files", "*.xlsx"
        .Show
    End With
    
    ' Check if any files were selected
    If FileDialog.SelectedItems.Count = 0 Then
        MsgBox "No files selected. Exiting the macro."
        Exit Sub
    End If

    ' Create the path for the folder where you want to save the PDF files
    SavePath = "C:\DDD\temp\" ' Modify this to your desired folder path
    
    ' Check if the folder exists, and if not, create it
    If Dir(SavePath, vbDirectory) = "" Then
        MkDir SavePath
    End If

    ' Loop through each selected file
    For i = 1 To FileDialog.SelectedItems.Count
        FilePath = FileDialog.SelectedItems(i)
        
        ' Open the selected Excel file
        Set wb = Workbooks.Open(FilePath)
        
        ' Split the selected path to get the file name and extension
        FileParts = Split(FilePath, Application.PathSeparator)
        OriginalWorkbookName = FileParts(UBound(FileParts))
        
        ' Remove the file extension from the original workbook name
        OriginalWorkbookName = Left(OriginalWorkbookName, InStrRev(OriginalWorkbookName, ".") - 1)
        
        ' Loop through each sheet in the workbook
        For j = 1 To wb.Sheets.Count
            wb.Sheets(j).Activate
            sheetName = wb.Sheets(j).Name
            
            ' Create the full PDF file name using the specified path, the Excel file name, and the sheet name
            PDFName = SavePath & OriginalWorkbookName & "_" & sheetName & ".pdf"
            
            ' Export the active sheet to a PDF file
            wb.Sheets(j).ExportAsFixedFormat Type:=xlTypePDF, Filename:=PDFName, Quality:=xlQualityStandard, _
                IncludeDocProperties:=True, IgnorePrintAreas:=False, OpenAfterPublish:=False
        Next j
        
        ' Close the original Excel file without saving changes
        wb.Close SaveChanges:=False
    Next i
    
    ThisWorkbook.Activate
    
    MsgBox "PDFs created successfully at " & SavePath, vbInformation, "Success"
End Sub
